# ─── xPartner Bank · configuração ─────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DB_PATH=.data/xpartner.db

# Demo libera dashboard, seed e simuladores. NUNCA use em produção.
DEMO_MODE=true
SEED_DEMO=true

# Segredo raiz. Em produção: >= 32 chars, via KMS/Secrets Manager, jamais no git.
# Chaves de dispositivo e de assinatura de token são derivadas dele (HKDF-like).
XPARTNER_MASTER_KEY=dev-master-key-change-me-please-32-chars

TOKEN_TTL_SECONDS=7200
HMAC_WINDOW_SECONDS=300
RATE_LIMIT_PER_MINUTE=240

# Fiscal (NFC-e modelo 65)
FISCAL_UF=SP
FISCAL_CUF=35
FISCAL_CMUN=3550308
FISCAL_AMBIENTE=homologacao
FISCAL_SERIES=1
FISCAL_REJECTION_PCT=6
FISCAL_LATENCY_MS=450
FISCAL_COMPANY_NAME=XPARTNER TECNOLOGIA LTDA

# Liquidação
SETTLEMENT_INTERVAL_MS=5000

# ─── Checkout mTLS (maquininhas) ──────────────────────────────────────────────
# Opcional. Sem os três caminhos, o listener HTTPS não sobe e a API segue em HTTP.
# As chaves são lidas só em runtime; NUNCA versione os arquivos .pem.
# MTLS_KEY_PATH=./certs/server-key.pem
# MTLS_CERT_PATH=./certs/server-cert.pem
# MTLS_CA_PATH=./certs/bank-ca-cert.pem
# MTLS_PORT=8443
# MTLS_REQUEST_CERT=true
# MTLS_REJECT_UNAUTHORIZED=true

